---
layout: layouts/base.njk
title: About
permalink: /about/
---

<section class="about-hero">
  <div class="about-hero-bg" style="background-image: url('{{ about.hero_image }}');"></div>
  <div class="about-hero-overlay"></div>
</section>

<div class="page-wrap">
  <span class="section-eyebrow">The Author</span>
  <span class="section-rule"></span>
  <h1 class="page-title">About</h1>

  <div class="about-grid">
    <div class="about-photo">
      <img src="{{ about.author_photo }}" alt="S. Lynn Cox" loading="lazy">
    </div>
    <div>
      <div class="about-bio prose">
        {{ about.bio | markdownify | safe }}
        {% if about.extended_bio %}
        {{ about.extended_bio | markdownify | safe }}
        {% endif %}
      </div>
      <div class="about-social">
        {% if settings.facebook_url %}<a href="{{ settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>{% endif %}
        {% if settings.instagram_url %}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>{% endif %}
        {% if settings.tiktok_url %}<a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
        </a>{% endif %}
        {% if settings.patreon_url %}<a href="{{ settings.patreon_url }}" target="_blank" rel="noopener" aria-label="Patreon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><circle cx="14.5" cy="9.5" r="6.5"/><rect x="2" y="2" width="3" height="20" rx="1"/></svg>
        </a>{% endif %}
        {% if settings.goodreads_url %}<a href="{{ settings.goodreads_url }}" target="_blank" rel="noopener" aria-label="Goodreads">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8.79 21.42c-.28-.13-.53-.31-.76-.53-.23-.22-.42-.49-.56-.79-.14-.31-.23-.65-.25-1.02h1.67c.05.28.14.51.28.71.14.19.31.35.51.47.2.12.42.2.66.25.24.05.48.08.72.08.55 0 1-.09 1.37-.28.37-.19.66-.44.88-.75.22-.31.37-.67.46-1.07.09-.4.13-.81.13-1.23v-1.5h-.04c-.29.53-.68.94-1.18 1.24-.5.3-1.08.45-1.73.45-.75 0-1.4-.14-1.96-.41-.56-.27-1.02-.65-1.4-1.12-.37-.48-.65-1.04-.83-1.68-.18-.64-.28-1.33-.28-2.07 0-.7.1-1.37.29-2.01.19-.64.48-1.2.86-1.69.38-.49.86-.88 1.42-1.16.56-.29 1.22-.43 1.96-.43.65 0 1.24.15 1.75.44.51.29.9.72 1.17 1.28h.04V7.72h1.58v9.16c0 .69-.08 1.33-.24 1.92-.16.59-.42 1.11-.77 1.54-.35.43-.81.77-1.37 1.02-.56.24-1.24.37-2.05.37-.47 0-.93-.06-1.38-.17-.32-.08-.61-.19-.89-.32zm.24-4.72c.25.37.57.66.95.87.38.21.83.31 1.34.31.53 0 .98-.11 1.36-.32.38-.22.69-.5.94-.86.24-.36.42-.77.54-1.24.11-.46.17-.94.17-1.42 0-.49-.06-.96-.18-1.42-.12-.46-.31-.86-.56-1.22-.25-.35-.57-.63-.95-.84-.38-.21-.83-.31-1.35-.31-.5 0-.94.1-1.31.31-.37.21-.68.49-.92.84-.24.36-.42.76-.54 1.22-.12.46-.18.93-.18 1.42 0 .48.05.96.16 1.42.11.47.28.89.53 1.25z"/></svg>
        </a>{% endif %}
      </div>
    </div>
  </div>
</div>
