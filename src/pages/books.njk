---
layout: layouts/base.njk
title: Books
permalink: /books/
---

<div class="page-wrap">
  <span class="section-eyebrow">Fiction</span>
  <span class="section-rule"></span>
  <h1 class="page-title">Books</h1>

  <div class="books-list">
    {% for book in books.books | sort(attribute="order") %}
    <div class="book-entry">
      <div class="book-cover-wrap">
        <img src="{{ book.cover }}" alt="Cover for {{ book.title }}" loading="lazy">
        {% if book.show_status != false %}<span class="book-status-badge">{{ book.status }}</span>{% endif %}
      </div>
      <div class="book-info">
        {% if book.label %}<span class="section-eyebrow">{{ book.label }}</span>{% endif %}
        <h2 class="book-info-title">{{ book.title }}</h2>
        <div class="book-genres">
          {% for genre in book.genres %}
          <span class="book-genre-tag">{{ genre }}</span>
          {% endfor %}
        </div>
        <div class="book-description prose">
          {{ book.description }}
        </div>
        {% if book.buy_link %}
        <a href="{{ book.buy_link }}" target="_blank" rel="noopener" class="btn btn-primary">Buy Now</a>
        {% else %}
        <span class="btn" style="opacity:0.5;cursor:default;pointer-events:none;">Coming Soon</span>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>
